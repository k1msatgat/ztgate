#!/bin/sh
# 이중화: 이 서버(주)의 설정을 다른 서버(부)들에 밀어 넣고 다시 읽게 한다.
#
#   ztgate-sync            /etc/ztgate-sync/sync.conf 의 PEERS 모두에게
#
# 서버들은 같은 기기 목록, ACL, 서버 키를 써야 클라이언트가 어느 서버로 넘어가도 같은 판정을 받는다
# (README 의 "서버 여러 대"). 설정을 고치는 곳은 주 서버 하나다. 부 서버에는 .sync-primary 표시가
# 생기고, 그 서버의 ztgate_ctl 은 설정을 고치는 명령을 거절한다. 고쳐 봐야 다음 동기화가 덮는다.
# 등록 코드(enroll.conf)는 보내지 않는다. 기기는 주 서버에서 등록한다.
#
# ztgate-sync.path 가 기기 목록이나 ACL 이 바뀔 때마다 부르고, ztgate-sync.timer 가 5분마다 한 번 더
# 부른다 (그때 꺼져 있던 부 서버를 따라잡게).
#
# sync.conf (셸 변수). 이 파일과 키는 /etc/ztgate 가 아니라 root 만 여는 /etc/ztgate-sync 에 둔다.
# /etc/ztgate 는 서버(ztgate 계정)가 쓸 수 있는 곳이라, 거기 두면 서버를 차지한 쪽이 root 로 도는
# 이 스크립트에 명령을 끼워 넣거나 부 서버로 가는 키를 가져갈 수 있다.
#   PEERS="sync@10.0.0.11"                  부 서버들. user@host 면 ssh 로, / 로 시작하면 이 PC 의 폴더로 (시험용)
#   SSH_KEY=/etc/ztgate-sync/sync.key       부 서버의 그 계정에 등록한 키 (기본: root 의 키)
#   RSYNC_PATH="sudo rsync"                 부 서버에서 /etc/ztgate 에 쓰는 명령
#   RELOAD="sudo systemctl reload ztgate"   부 서버에서 다시 읽기
#   RESTART="sudo systemctl restart ztgate" 서버 키가 바뀌었거나 ACL / 로그인 / DNS 를 켜고 끌 때 (뜰 때만 정해진다)
# 부 서버의 그 계정에는 rsync 와 위의 두 systemctl 만 NOPASSWD 로 연다.
set -eu

ETC=${ZTGATE_ETC:-/etc/ztgate}
CONF=${ZTGATE_SYNC_CONF:-/etc/ztgate-sync/sync.conf}
# 서버 키도 간다. 같은 서버 키라야 등록 때 고정한 서버 공개키로 어느 서버에나 붙는다. server.env 는
# 서버마다 다르다 (FORWARD_OUT 의 인터페이스 이름 등).
FILES="devices.conf acl.conf idp.conf jwks.json dns.conf server.key"
# 폴더를 통째로 보내되 이 파일들만 고른다. --delete 는 고른 이름만 지우므로 부 서버의 server.env,
# enroll.conf, .sync-primary 는 남는다. 파일 이름을 늘어놓고 --delete-missing-args 로 지우던 것은
# 프로토콜 32 의 rsync(Debian 12 의 3.2.7)가 없는 파일에서 "invalid file mode 00" 으로 멈췄다.
PICK=
for f in $FILES; do PICK="$PICK --include=$f"; done

if [ ! -r "$CONF" ]; then
	echo "ztgate-sync: $CONF not found; write PEERS=\"user@host ...\" there (root, mode 600)" >&2
	exit 1
fi
# 이 파일은 셸로 읽는다. 이 스크립트를 부른 계정의 것이고 다른 누구도 쓸 수 없을 때만.
set -- $(stat -L -c '%u %a' "$CONF")
case "$1:$2" in
"$(id -u)":?[0145][0145]) ;;
*)
	echo "ztgate-sync: $CONF must be owned by $(id -un) and writable by no one else (chmod 600)" >&2
	exit 1
	;;
esac
case "$CONF" in
"$ETC"/*)
	echo "ztgate-sync: keep $CONF out of $ETC (the server can write there); use /etc/ztgate-sync" >&2
	exit 1
	;;
esac

PEERS=
SSH_KEY=
RSYNC_PATH="sudo rsync"
RELOAD="sudo systemctl reload ztgate"
RESTART="sudo systemctl restart ztgate"
. "$CONF"
if [ -z "$PEERS" ]; then
	echo "ztgate-sync: no PEERS in $CONF" >&2
	exit 1
fi
if [ -e "$ETC/.sync-primary" ]; then
	echo "ztgate-sync: this server takes its configuration from $(cat "$ETC/.sync-primary"); run it there" >&2
	exit 1
fi

ssh_cmd="ssh -o BatchMode=yes -o ConnectTimeout=10"
[ -n "$SSH_KEY" ] && ssh_cmd="$ssh_cmd -i $SSH_KEY"

mark=$(mktemp)
changes=$(mktemp)
trap 'rm -f "$mark" "$changes"' EXIT
hostname > "$mark"
# 부 서버의 ztgate_ctl 은 root 가 아니어도 이 표시를 읽어 거절 사유를 보여 준다.
chmod 644 "$mark"

# 다시 읽기로는 반영되지 않는 바뀜: 서버 키는 뜰 때만 읽고, ACL / 로그인 / DNS 는 뜰 때 파일이 있는지로
# 켜고 끈다. rsync -i 의 줄로 가린다 (>f+++ 새로, *deleting 지움, >f 로 시작하면 내용이 바뀜).
needs_restart() {
	grep -Eq '^[<>]f.* server\.key$|^[<>]f\+{9,} (acl|idp|dns)\.conf$|^\*deleting +(acl|idp|dns)\.conf$' "$changes"
}

cd "$ETC"
failed=0
for peer in $PEERS; do
	# 주에 없는 파일(acl.conf 를 지웠다)은 부에서도 지운다 (--delete). 파일마다 옆에 쓰고
	# 이름을 바꾸므로 부 서버가 반쯤 쓰인 파일을 읽지 않는다. 다시 읽기는 다 보낸 뒤 한 번. -c: 같은 초에
	# 같은 크기로 바뀐 파일(이름표를 같은 길이로 고쳤다)도 내용으로 가려 보낸다.
	case $peer in
	/*)
		if rsync -aci --delete $PICK --exclude='*' ./ "$peer/" > "$changes" && cp "$mark" "$peer/.sync-primary"; then
			if needs_restart; then how=restarted; sh -c "$RESTART"; else how=reloaded; sh -c "$RELOAD"; fi &&
				echo "ztgate-sync: $peer: done ($how)" && continue
		fi
		echo "ztgate-sync: $peer: failed" >&2
		failed=1
		;;
	*)
		if rsync -aci --delete $PICK --exclude='*' -e "$ssh_cmd" --rsync-path="$RSYNC_PATH" ./ "$peer:$ETC/" > "$changes" &&
				rsync -a -e "$ssh_cmd" --rsync-path="$RSYNC_PATH" "$mark" "$peer:$ETC/.sync-primary"; then
			if needs_restart; then how=restarted; $ssh_cmd "$peer" "$RESTART"; else how=reloaded; $ssh_cmd "$peer" "$RELOAD"; fi &&
				echo "ztgate-sync: $peer: done ($how)" && continue
		fi
		echo "ztgate-sync: $peer: failed" >&2
		failed=1
		;;
	esac
done
exit $failed
