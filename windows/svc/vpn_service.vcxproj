<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{7A41D6E2-93B5-4C08-8F1E-6D2B5A0C9E34}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>vpn_service</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <!-- $(SolutionDir) 는 .sln 을 통해 빌드할 때만 정의된다. msbuild 로 이 .vcxproj 를
       직접 빌드해도 되도록 프로젝트 위치를 기준으로 삼는다. -->
  <PropertyGroup Label="Paths">
    <WindowsRoot>$(MSBuildProjectDirectory)\..</WindowsRoot>
    <RepoRoot>$(MSBuildProjectDirectory)\..\..</RepoRoot>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <!-- 설치된 VS의 기본 툴셋을 쓴다. VS2022는 v143, VS2026은 v145.
       Microsoft.Cpp.Default.props가 $(DefaultPlatformToolset)을 채워주므로 이 위치여야 한다. -->
  <PropertyGroup Label="Toolset">
    <ZtgateToolset Condition="'$(DefaultPlatformToolset)'!=''">$(DefaultPlatformToolset)</ZtgateToolset>
    <ZtgateToolset Condition="'$(ZtgateToolset)'==''">v143</ZtgateToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>$(ZtgateToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>$(ZtgateToolset)</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup>
    <OutDir>$(WindowsRoot)\build\$(Configuration)\</OutDir>
    <IntDir>$(WindowsRoot)\build\obj\$(ProjectName)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <AdditionalIncludeDirectories>$(RepoRoot)\lib\common\include;$(WindowsRoot)\core;$(WindowsRoot)\third_party\wintun\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;_CRT_SECURE_NO_WARNINGS;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- 소스는 Linux와 공유하므로 UTF-8(BOM 없음)이다. MSVC는 기본적으로 시스템 코드페이지로
           읽어 한글 주석에서 C4819가 나므로 입력/실행 문자셋을 UTF-8로 못박는다. -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>ws2_32.lib;iphlpapi.lib;bcrypt.lib;crypt32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="main.c" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="vpn_service.rc" />
    <!-- tunnel.c 는 서버의 LOGIN 답이 지금 토큰의 것인지 보려고 토큰의 exp 를 읽는다. 서버가
         JWT 를 읽는 파서를 그대로 쓴다. 서버의 헤더 폴더에는 이름이 같은 헤더(device.h)가 있어
         이 두 파일에만, 맨 뒤에 붙인다. -->
    <ClCompile Include="..\core\tunnel.c">
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(RepoRoot)\server\include</AdditionalIncludeDirectories>
    </ClCompile>
    <ClCompile Include="..\..\server\src\json.c">
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(RepoRoot)\server\include</AdditionalIncludeDirectories>
    </ClCompile>
    <ClCompile Include="..\core\posture.c" />
    <ClCompile Include="..\core\tpm.c" />
    <ClCompile Include="..\core\wfp.c" />
    <ClCompile Include="..\core\policy.c" />
    <ClCompile Include="..\core\crypt.c" />
    <ClCompile Include="..\core\device.c" />
    <ClCompile Include="..\core\ipc.c" />
    <ClCompile Include="..\core\filelog.c" />
    <ClCompile Include="..\..\lib\common\src\proto.c" />
    <ClCompile Include="..\..\lib\common\src\secure.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\core\tunnel.h" />
    <ClInclude Include="..\core\posture.h" />
    <ClInclude Include="..\core\tpm.h" />
    <ClInclude Include="..\core\wfp.h" />
    <ClInclude Include="..\core\policy.h" />
    <ClInclude Include="..\..\lib\common\include\crypt.h" />
    <ClInclude Include="..\..\lib\common\include\secure.h" />
    <ClInclude Include="..\core\device.h" />
    <ClInclude Include="..\core\ipc.h" />
    <ClInclude Include="..\..\lib\common\include\proto.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- wintun.dll 을 실행 파일 옆에 둔다. 콘솔 클라이언트와 서비스가 같은 출력 폴더에 같은
       파일을 두므로, 병렬 빌드(-m)에서 copy 명령 둘이 동시에 쓰다 한쪽이 실패했다. MSBuild 의
       Copy 는 같은 파일이면 건너뛰고 잠겨 있으면 다시 시도한다. -->
  <Target Name="CopyWintun" AfterTargets="Build">
    <Copy SourceFiles="$(WindowsRoot)\third_party\wintun\bin\amd64\wintun.dll" DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" Retries="10" RetryDelayMilliseconds="200" />
  </Target>
</Project>
