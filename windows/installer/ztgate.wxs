<?xml version="1.0" encoding="utf-8"?>
<!--
  ztgate Windows 설치 파일 (WiX 3). windows/installer/build.ps1 이 만든다.

  vpn_service install 이 하던 일을 Windows Installer 의 표준 방식으로 한다. 그러면 설치와 제거,
  업그레이드가 "앱 및 기능"에 하나로 보이고, 도중에 실패하면 Windows Installer 가 되돌린다.

    Program Files\ztgate\   vpn_service.exe, vpn_gui.exe, vpn_client.exe, wintun.dll (+ 라이선스)
    서비스 ztgate           자동 시작, LocalSystem, 죽으면 다시 올린다
    시작 메뉴               ztgate (GUI)

  서비스는 시스템 권한으로 돈다. 실행 파일이 관리자만 쓸 수 있는 Program Files 에 있어야
  일반 사용자가 바꿔치기해 시스템 권한을 얻지 못한다 (vpn_service install 과 같은 이유).

  기기 신원(레지스트리, DPAPI)은 설치 파일이 만들지도 지우지도 않는다. 지웠다가 다시 설치해도
  같은 기기로 붙는다.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <?ifndef Version?>
  <?define Version = "0.9.4"?>
  <?endif?>
  <?ifndef BinDir?>
  <?define BinDir = "..\build\Release"?>
  <?endif?>

  <!-- UpgradeCode 는 바꾸지 않는다. 같은 값이어야 새 버전이 옛 버전을 알아보고 갈아 끼운다. -->
  <Product Id="*" Name="ztgate" Language="1033" Version="$(var.Version)"
           Manufacturer="ztgate" UpgradeCode="CA4F450C-EECB-43FC-BDAC-8F06B153C5A6">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="ztgate ZTNA client $(var.Version)" />

    <!-- 새 버전을 설치하면 옛 버전을 지우고 올린다. 더 새 버전이 깔려 있으면 멈춘다. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of ztgate is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- 8.1 이상(VersionNT 603 — 10 과 11 도 호환 목록 없는 설치 파일에는 603 으로 보인다).
         DLL 을 시스템 폴더에서만 불러오는 LoadLibraryEx 플래그가 그 위에 있다. 확인한 것은 10 과 11. -->
    <Condition Message="ztgate needs Windows 8.1 or later.">
      <![CDATA[Installed OR VersionNT >= 603]]>
    </Condition>

    <!-- 설치하며 설정한다: msiexec /i ztgate.msi SERVER=vpn.example.com PORT=9000 CODE=7K2QF-...
         셋 다 비워 두면 지금처럼 초대 링크나 GUI 로 나중에 정한다.

         SERVER, PORT   GUI 서버 칸의 기본값이 된다 (HKLM\SOFTWARE\ztgate\install). 정책의 Servers 와
                        사용자가 GUI 에 적은 값이 앞선다. 업그레이드에서 SERVER 를 주면 바꾸고, 주지 않으면
                        있던 값을 둔다. 제거해도 남는다 (신원과 같이, 다시 설치하면 그대로 붙는다).
         CODE           등록 코드. 서비스가 뜨면서 그 코드로 이 PC 를 등록한다 (HKLM\SOFTWARE\ztgate\enroll,
                        SYSTEM 과 Administrators 만 읽는다). SERVER 없이 주면 이미 적힌 서버로 한다.
                        이미 등록된 PC 에서는 쓰지 않는다. 한 번 쓰이면 끝나는 비밀이라 Hidden 으로
                        자세한 설치 기록(/l*v)에 남기지 않는다.

         Secure 여야 관리자 권한으로 도는 설치 단계까지 값이 넘어간다. -->
    <Property Id="SERVER" Secure="yes" />
    <Property Id="PORT" Value="9000" Secure="yes" />
    <Property Id="CODE" Secure="yes" Hidden="yes" />

    <!-- vpn_service preset 이 형식을 보고 적는다 (windows/core/preset.h). 틀리면 설치를 되돌린다:
         설치 기록의 "returned actual error code" 가 2 SERVER, 3 PORT, 4 CODE, 5 서버 없는 CODE 다.
         HideTarget 은 명령 줄(코드가 들어 있다)을 기록에 남기지 않는다. 서비스가 뜨기 전이어야
         뜨자마자 코드를 본다. -->
    <CustomAction Id="Preset" FileKey="vpn_service.exe" Execute="deferred" Impersonate="no" Return="check"
                  HideTarget="yes" ExeCommand="preset &quot;[SERVER]&quot; &quot;[PORT]&quot; &quot;[CODE]&quot;" />
    <InstallExecuteSequence>
      <Custom Action="Preset" Before="StartServices"><![CDATA[(SERVER OR CODE) AND NOT REMOVE~="ALL"]]></Custom>
    </InstallExecuteSequence>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ztgate" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="Service" Guid="*" Win64="yes">
        <File Id="vpn_service.exe" Source="$(var.BinDir)\vpn_service.exe" KeyPath="yes" />

        <!-- 인자 없이 뜨면 서비스로 돈다 (svc/main.c). -->
        <ServiceInstall Id="ServiceInstall" Name="ztgate" DisplayName="ztgate tunnel"
                        Description="Keeps the ztgate tunnel up. The GUI talks to this service; it does not hold the tunnel itself."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes">
          <!-- 죽으면 5초 뒤에 다시 올린다. 하루에 한 번 센 값을 지운다. -->
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                              ThirdFailureActionType="restart" RestartServiceDelayInSeconds="5"
                              ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="ServiceControl" Name="ztgate" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <!-- 쓰이지 않은 등록 코드는 제거할 때 함께 지운다. 서버 기본값(install)은 신원처럼 남긴다. -->
        <RemoveRegistryKey Id="PendingEnroll" Root="HKLM" Key="Software\ztgate\enroll" Action="removeOnUninstall" />
      </Component>

      <Component Id="Wintun" Guid="*" Win64="yes">
        <File Id="wintun.dll" Source="$(var.BinDir)\wintun.dll" KeyPath="yes" />
        <File Id="wintun_LICENSE.txt" Source="$(var.BinDir)\wintun-LICENSE.txt" />
      </Component>

      <!-- ztgate 의 라이선스와 함께 배포하는 구성 요소의 고지 (저장소 맨 위의 LICENSE, THIRD_PARTY_NOTICES.md). -->
      <Component Id="License" Guid="*" Win64="yes">
        <File Id="LICENSE.txt" Source="$(var.BinDir)\LICENSE.txt" KeyPath="yes" />
      </Component>
      <Component Id="Notices" Guid="*" Win64="yes">
        <File Id="THIRD_PARTY_NOTICES.md" Source="$(var.BinDir)\THIRD_PARTY_NOTICES.md" KeyPath="yes" />
      </Component>

      <Component Id="Gui" Guid="*" Win64="yes">
        <File Id="vpn_gui.exe" Source="$(var.BinDir)\vpn_gui.exe" KeyPath="yes">
          <Shortcut Id="GuiShortcut" Directory="ProgramMenuFolder" Name="ztgate"
                    Description="ztgate: connect, sign in, diagnostics" WorkingDirectory="INSTALLFOLDER" Advertise="yes" />
        </File>
        <!-- 초대 링크 (ztgate://enroll?server=...&port=...&code=...) 를 누르면 GUI 의 등록 창이 열린다. -->
        <RegistryKey Root="HKLM" Key="Software\Classes\ztgate">
          <RegistryValue Type="string" Value="URL:ztgate invite" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]vpn_gui.exe&quot;,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]vpn_gui.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
      </Component>

      <Component Id="Console" Guid="*" Win64="yes">
        <File Id="vpn_client.exe" Source="$(var.BinDir)\vpn_client.exe" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- 두 번 눌러 설치하는 사람에게도 같은 셋을 묻는다. 시작 → 연결 설정 → 설치 준비 → 진행 → 끝.
         나머지는 WixUIExtension 의 표준 창이고, 바꾼 것은 연결 설정 창 하나다 (WixUI_InstallDir 에서
         폴더와 라이선스 창을 뺀 흐름). 비워 두고 [다음] 을 눌러도 된다. -->
    <UI Id="ZtgateUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="!(loc.Advanced_Font_FaceName)" Size="!(loc.Advanced_Font_Normal_Size)" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="!(loc.Advanced_Font_FaceName)" Size="!(loc.Advanced_Font_Bigger_Size)" />
      <TextStyle Id="WixUI_Font_Title" FaceName="!(loc.Advanced_Font_FaceName)" Size="!(loc.Advanced_Font_Title_Size)" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="InstallDir" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Dialog Id="ConnectDlg" Width="370" Height="270" Title="!(loc.WelcomeDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}연결 설정" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="관리자에게 받은 서버와 등록 코드 (선택)" />

        <Control Id="Intro" Type="Text" X="20" Y="56" Width="330" Height="40" NoPrefix="yes"
                 Text="서버 주소와 등록 코드를 적으면 설치하면서 이 PC 를 등록합니다. 비워 두면 설치한 뒤 관리자에게 받은 초대 링크를 누르거나 ztgate 의 [\[]기기 등록[\]] 에서 할 수 있습니다." />
        <Control Id="ServerLabel" Type="Text" X="20" Y="104" Width="80" Height="12" NoPrefix="yes" Text="서버 주소" />
        <Control Id="Server" Type="Edit" X="105" Y="102" Width="245" Height="17" Property="SERVER" />
        <Control Id="PortLabel" Type="Text" X="20" Y="128" Width="80" Height="12" NoPrefix="yes" Text="포트" />
        <Control Id="Port" Type="Edit" X="105" Y="126" Width="60" Height="17" Property="PORT" />
        <Control Id="CodeLabel" Type="Text" X="20" Y="152" Width="80" Height="12" NoPrefix="yes" Text="등록 코드" />
        <Control Id="Code" Type="Edit" X="105" Y="150" Width="245" Height="17" Property="CODE" />
        <Control Id="Hint" Type="Text" X="105" Y="172" Width="245" Height="40" NoPrefix="yes"
                 Text="서버가 여럿이면 쉼표로 나눠 적습니다. 코드는 한 번만 쓰이며, 이미 등록된 PC 에서는 쓰지 않습니다. 서버에 닿지 않으면 나중에 다시 시도합니다." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="ConnectDlg">NOT Installed</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">Installed AND PATCH</Publish>
      <Publish Dialog="ConnectDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg">1</Publish>
      <Publish Dialog="ConnectDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ConnectDlg" Order="1">NOT Installed</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2">Installed AND NOT PATCH</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2">Installed AND PATCH</Publish>

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>

      <Property Id="ARPNOMODIFY" Value="1" />
    </UI>
    <UIRef Id="WixUI_Common" />

    <Feature Id="Main" Title="ztgate" Level="1">
      <ComponentRef Id="Service" />
      <ComponentRef Id="Wintun" />
      <ComponentRef Id="License" />
      <ComponentRef Id="Notices" />
      <ComponentRef Id="Gui" />
      <ComponentRef Id="Console" />
    </Feature>
  </Product>
</Wix>
