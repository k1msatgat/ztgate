#include <windows.h>
#include <commctrl.h>
#include "resource.h"

/* 소스는 UTF-8(BOM 없음)이므로 rc.exe 에게 코드 페이지를 알려준다.
 * MFC 의 afxres.h 는 쓰지 않는다 — 다이얼로그 하나와 컨트롤 ID 만 필요하고,
 * windows.h 만으로 충분해서 MFC 가 없는 환경에서도 이 .rc 는 컴파일된다. */
#pragma code_page(65001)

LANGUAGE LANG_KOREAN, SUBLANG_DEFAULT

IDI_APP ICON "app.ico"

/* 주 창. 여기 좌표는 초깃값일 뿐이다 — 창 크기와 배치는 CMainDlg::FitWindow /
 * LayoutChildren 이 다시 잡는다. 상태, 보안 상태, 연결 정보 판은 컨트롤이 아니라 다이얼로그가
 * 바탕에 직접 그린다. 그 위에 놓인 버튼이 바탕 그리기에 덮이지 않게 WS_CLIPCHILDREN 을 준다.
 * 컨트롤의 순서가 Tab 키로 옮겨 다니는 순서다. 크기는 고정이다 (늘려도 보여 줄 것이 없다). */
IDD_MAIN DIALOGEX 0, 0, 240, 400
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU |
      WS_MINIMIZEBOX | WS_CLIPCHILDREN
CAPTION "ztgate"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "연결", IDC_CONNECT, 20, 120, 200, 24
    PUSHBUTTON      "설정", IDC_SETTINGS, 10, 370, 70, 18
    PUSHBUTTON      "기기 등록", IDC_ENROLL, 85, 370, 70, 18
    PUSHBUTTON      "진단", IDC_DIAG, 160, 370, 70, 18
    PUSHBUTTON      "로그인", IDC_LOGIN, 180, 300, 40, 14
END

/* 진단 창. 패킷 표, 로그, 통계. 주 창과 같이 실제 배치는 CDiagDlg::LayoutChildren 이 잡고,
 * 통계 타일과 판은 다이얼로그가 직접 그린다. */
IDD_DIAG DIALOGEX 0, 0, 600, 380
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU |
      WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "ztgate 진단"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_TAB, "ZtgateTabs", WS_TABSTOP, 12, 54, 100, 18

    COMBOBOX        IDC_FILTER_DIR, 300, 56, 52, 80,
                    CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    CONTROL         "keepalive 숨김", IDC_HIDE_KA, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 358, 58, 76, 10
    CONTROL         "폐기만", IDC_ONLY_DROPS, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 438, 58, 44, 10
    PUSHBUTTON      "지움", IDC_CLEAR, 496, 56, 36, 14
    PUSHBUTTON      "저장...", IDC_SAVE, 536, 56, 42, 14

    CONTROL         "", IDC_PACKETS, WC_LISTVIEW,
                    LVS_REPORT | LVS_OWNERDATA | LVS_SINGLESEL |
                    LVS_SHOWSELALWAYS | WS_TABSTOP, 10, 76, 580, 170
    LISTBOX         IDC_LOG, 10, 76, 580, 170,
                    LBS_NOINTEGRALHEIGHT | LBS_NOSEL | WS_VSCROLL | WS_HSCROLL |
                    NOT WS_BORDER | NOT WS_VISIBLE

    EDITTEXT        IDC_DETAIL, 16, 282, 568, 68,
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL |
                    NOT WS_BORDER | NOT WS_TABSTOP
END

/* 연결 설정. 꾸미지 않은 표준 다이얼로그다. */
IDD_SETTINGS DIALOGEX 0, 0, 260, 215
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "연결 설정"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "서버 주소", IDC_STATIC, 14, 16, 50, 9
    EDITTEXT        IDC_SERVER, 70, 14, 176, 13, ES_AUTOHSCROLL
    LTEXT           "포트", IDC_STATIC, 14, 35, 50, 9
    EDITTEXT        IDC_PORT, 70, 33, 50, 13, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "어댑터 이름", IDC_STATIC, 14, 54, 50, 9
    EDITTEXT        IDC_ADAPTER, 70, 52, 100, 13, ES_AUTOHSCROLL
    LTEXT           "어댑터는 연결할 때 이 PC 에 생기는 가상 네트워크 장치입니다. 터널 주소는 서버가 정해 줍니다.", IDC_STATIC, 14, 72, 232, 18

    LTEXT           "로그인 주소", IDC_STATIC, 14, 102, 54, 9
    EDITTEXT        IDC_ISSUER, 70, 100, 176, 13, ES_AUTOHSCROLL
    LTEXT           "클라이언트 ID", IDC_STATIC, 14, 121, 54, 9
    EDITTEXT        IDC_CLIENT_ID, 70, 119, 100, 13, ES_AUTOHSCROLL
    LTEXT           "범위 (scope)", IDC_STATIC, 14, 140, 54, 9
    EDITTEXT        IDC_SCOPE, 70, 138, 176, 13, ES_AUTOHSCROLL
    LTEXT           "회사 계정으로 로그인할 IdP(OpenID Connect)의 발급자 주소입니다. 관리자가 알려 줍니다. 비워 두면 사용자 로그인 없이 기기 신원만으로 연결합니다.", IDC_STATIC, 14, 158, 232, 27

    DEFPUSHBUTTON   "저장", IDOK, 128, 193, 56, 16
    PUSHBUTTON      "취소", IDCANCEL, 190, 193, 56, 16
END

IDD_ENROLL DIALOGEX 0, 0, 356, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
CAPTION "기기 등록"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    /* 제목과 안내, 경고는 다이얼로그가 직접 그린다 (CEnrollDlg::OnPaint). */
    LTEXT           "기기 ID", IDC_STATIC, 16, 58, 40, 9
    EDITTEXT        IDC_ENROLL_ID, 58, 56, 282, 13, ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "키", IDC_STATIC, 16, 77, 40, 9
    EDITTEXT        IDC_ENROLL_KEY, 58, 75, 282, 13, ES_AUTOHSCROLL | ES_READONLY

    DEFPUSHBUTTON   "한 줄로 복사", IDC_ENROLL_COPY, 196, 122, 76, 18
    PUSHBUTTON      "닫기", IDOK, 278, 122, 62, 18
END

/* 등록 코드를 받는 창. 꾸미지 않은 표준 다이얼로그다 — 칸 하나와 버튼 셋이다. */
IDD_ENROLL_CODE DIALOGEX 0, 0, 300, 112
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "기기 등록"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "관리자에게 받은 등록 코드를 적어 주세요. 이 기기의 ID 와 키를 만들어 서버에 올립니다. 키는 암호화된 채로 가고, 화면에 나오지 않습니다.", IDC_STATIC, 14, 10, 272, 27
    LTEXT           "등록 코드", IDC_STATIC, 14, 46, 40, 9
    EDITTEXT        IDC_ENROLL_CODE, 58, 44, 228, 13, ES_AUTOHSCROLL | ES_UPPERCASE
    LTEXT           "", IDC_ENROLL_ID, 14, 64, 272, 9

    PUSHBUTTON      "코드 없이...", IDC_ENROLL_MANUAL, 14, 86, 66, 18
    DEFPUSHBUTTON   "서버에 등록", IDOK, 150, 86, 70, 18
    PUSHBUTTON      "취소", IDCANCEL, 224, 86, 62, 18
END

#define ZTGATE_FILE_DESC "ztgate"
#define ZTGATE_FILE_NAME "vpn_gui.exe"
#include "../version.rc"
