/* 세 실행 파일(vpn_service, vpn_client, vpn_gui)의 버전 정보. 프로젝트마다 ZTGATE_FILE_DESC 와
 * ZTGATE_FILE_NAME 을 정의하고 이 파일을 포함한다.
 *
 * 버전이 있어야 설치 파일(ztgate.msi)이 업그레이드 때 옛 파일을 갈아 끼운다. Windows Installer 는
 * 버전이 없는 파일이 이미 있으면 그 파일을 사용자가 고친 것으로 보고 덮지 않는다 — 그래서 옛
 * 실행 파일이 남은 채 "설치 성공"이 되는 일이 있었다. 버전은 CHANGELOG 의 버전과 같게 올린다.
 * 두 번째 숫자는 프로토콜 버전이다. */
#include <winver.h>

#define ZTGATE_VERSION_NUM	0,9,2,0
#define ZTGATE_VERSION_STR	"0.9.2.0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ZTGATE_VERSION_NUM
PRODUCTVERSION ZTGATE_VERSION_NUM
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "ztgate"
			VALUE "FileDescription", ZTGATE_FILE_DESC
			VALUE "FileVersion", ZTGATE_VERSION_STR
			VALUE "InternalName", ZTGATE_FILE_NAME
			VALUE "OriginalFilename", ZTGATE_FILE_NAME
			VALUE "ProductName", "ztgate"
			VALUE "ProductVersion", ZTGATE_VERSION_STR
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
